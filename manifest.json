{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "bundled:career-engine",
      "min_version": "1.0.0",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "storage": {
    "kv": true,
    "files": false,
    "scopes": {
      "user": "rw",
      "tool": "rw"
    }
  },
  "system_prompt_addendum": "Career Forge uses the career-engine tool for deterministic ATS scans and keyword/bullet audits. Its Python writing actions are legacy templates, not AI. In-app writing generation uses Anna LLM directly. Never present ATS scores as hiring predictions or add unsupported experience or metrics.",
  "user_message_prefix_template": "[Career Forge] {user_message}",
  "tags": [
    "productivity",
    "career",
    "resume",
    "ats",
    "job-search",
    "interview-prep"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "form_factors": [
      "desktop",
      "mobile"
    ],
    "views": [
      {
        "name": "main",
        "title": "Career Forge \u2014 AI Resume & Job Match Studio",
        "default": true,
        "entry": "index.html",
        "min_size": {
          "w": 420,
          "h": 560
        },
        "default_size": {
          "w": 960,
          "h": 720
        },
        "max_size": {
          "w": 1600,
          "h": 1100
        },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "icon": "icon.svg"
      }
    ],
    "host_api": {
      "tools": [
        "required:*"
      ],
      "chat": [],
      "artifact": [],
      "llm": [
        "complete"
      ],
      "fs": [],
      "storage": [
        "get",
        "set",
        "delete",
        "list"
      ],
      "prefs": [],
      "window": [
        "set_title"
      ]
    },
    "csp_overrides": {
      "img-src": [
        "'self'",
        "data:",
        "blob:"
      ],
      "font-src": [
        "'self'",
        "data:"
      ],
      "style-src": [
        "'self'"
      ],
      "script-src": [
        "'self'"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": [],
    "seed_storage": {},
    "user_id": 1
  }
}
